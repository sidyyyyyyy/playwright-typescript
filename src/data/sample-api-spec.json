{
  "openapi": "3.0.0",
  "info": {
    "title": "Health Plan API",
    "version": "1.0.0",
    "description": "API for Health Plan Member Management"
  },
  "paths": {
    "/api/address/update": {
      "post": {
        "summary": "Update member address",
        "parameters": [
          {
            "name": "memberId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newAddress": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}